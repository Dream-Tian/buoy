<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Buoy.SettingsWindow"
        Classes="shell"
        FontFamily="{DynamicResource AppFontFamily}"
        Title="Buoy 设置"
        ShowInTaskbar="False"
        Width="460"
        Height="440"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Border Classes="shell" Padding="14,12">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Classes="title" FontSize="17" Text="设置" />
          <TextBlock x:Name="VersionText" Classes="muted" FontSize="10" />
        </StackPanel>
        <Border Grid.Column="1" Classes="track" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,6,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="SourceTab" Classes="segment active" Content="来源" Click="TabButton_Click" Tag="Source" />
            <Button x:Name="WindowTab" Classes="segment" Content="窗口" Click="TabButton_Click" Tag="Window" />
            <Button x:Name="FilterTab" Classes="segment" Content="筛选" Click="TabButton_Click" Tag="Filter" />
            <Button x:Name="DataTab" Classes="segment" Content="数据" Click="TabButton_Click" Tag="Data" />
            <Button x:Name="UpdateTab" Classes="segment" Content="更新" Click="TabButton_Click" Tag="Update" />
          </StackPanel>
        </Border>
        <Button Grid.Column="2" Classes="icon" Click="CloseButton_Click" VerticalAlignment="Center" ToolTip.Tip="关闭">
          <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource AppMutedBrush}"
                StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <Grid>
          <StackPanel x:Name="SourcePage" Spacing="8">
            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="NewAPI" />
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="服务地址" />
                  <TextBox x:Name="BaseUrlBox" Classes="field" MinHeight="30" Watermark="https://new-api.example.com/" />
                </StackPanel>
                <Grid ColumnDefinitions="*,100">
                  <StackPanel Spacing="4" Margin="0,0,8,0">
                    <TextBlock Classes="muted" Text="系统 Token" />
                    <TextBox x:Name="TokenBox" Classes="field" MinHeight="30" PasswordChar="•" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="muted" Text="用户 ID" />
                    <TextBox x:Name="UserIdBox" Classes="field" MinHeight="30" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Classes="action" Content="测试连接" Click="TestButton_Click" />
                  <Button Classes="primary" Content="保存" Click="SaveNewApiButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="WorkBuddy AI（国际版）" VerticalAlignment="Center" />
                  <CheckBox x:Name="WorkBuddyBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="WorkBuddyBox_Click" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="读本机 ~/.workbuddy-ai 的会话记录，只取 token 数和模型名，不读对话内容、不上传。来源名记为「WorkBuddy AI」。" />
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="WorkBuddy（国内版）" VerticalAlignment="Center" />
                  <CheckBox x:Name="WorkBuddyCnBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="WorkBuddyCnBox_Click" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="读本机 ~/.workbuddy 的会话记录，口径同上。来源名记为「WorkBuddy」，与国际版分开统计。" />
              </StackPanel>
            </Border>

            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="本地 Antigravity" VerticalAlignment="Center" />
                  <CheckBox x:Name="AntigravityBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="需要 IDE 运行并登录。配额单独显示；订阅费用不作估算。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button x:Name="TestAntigravityButton" Classes="action" Content="测试配额" Click="TestAntigravityButton_Click" />
                  <Button Classes="action" Content="保存并刷新" Click="SaveAntigravityButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="ChatGPT(Codex 官方登录)" VerticalAlignment="Center" />
                  <CheckBox x:Name="ChatGptBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="需要 Codex 用 ChatGPT 账号登录（codex login）。读取 5 小时和每周用量窗口；自定义 NewAPI 不在此列。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button x:Name="TestChatGptButton" Classes="action" Content="测试额度" Click="TestChatGptButton_Click" />
                  <Button Classes="action" Content="保存并刷新" Click="SaveChatGptButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="WindowPage" IsVisible="False">
            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="9">
                <TextBlock Classes="section-title" Text="窗口" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="统计刷新间隔" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" />
                  <ComboBox x:Name="IntervalBox" Grid.Column="1" Width="132" MinHeight="28" HorizontalAlignment="Right"
                            SelectionChanged="IntervalBox_SelectionChanged">
                    <ComboBoxItem Content="10 秒" Tag="10" />
                    <ComboBoxItem Content="30 秒" Tag="30" />
                    <ComboBoxItem Content="1 分钟" Tag="60" />
                    <ComboBoxItem Content="5 分钟" Tag="300" />
                  </ComboBox>
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="系统小组件范围" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" Text="系统自带小组件显示的时间段" />
                  </StackPanel>
                  <ComboBox x:Name="WidgetRangeBox" Grid.Column="1" Width="132" MinHeight="28" HorizontalAlignment="Right"
                            SelectionChanged="WidgetRangeBox_SelectionChanged">
                    <ComboBoxItem Content="本日" Tag="today" />
                    <ComboBoxItem Content="本周" Tag="week" />
                    <ComboBoxItem Content="本月" Tag="month" />
                    <ComboBoxItem Content="最近 24 小时" Tag="24h" />
                    <ComboBoxItem Content="最近一周" Tag="7d" />
                    <ComboBoxItem Content="最近一月" Tag="30d" />
                  </ComboBox>
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="仅窗口可见时刷新" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" />
                  <CheckBox x:Name="VisibleOnlyBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="VisibleOnlyBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="置于顶层" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" Text="主窗口和设置窗口保持在其他窗口之上" />
                  </StackPanel>
                  <CheckBox x:Name="KeepOnTopBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="KeepOnTopBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="桌面小组件" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="缩成小卡片贴在桌面层，不挡其他窗口" />
                  </StackPanel>
                  <CheckBox x:Name="WidgetModeBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="WidgetModeBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="迷你模式" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="只显示今日 Token 和已知消耗，双击窗口可来回切换" />
                  </StackPanel>
                  <CheckBox x:Name="MiniModeBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="MiniModeBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="开机自启" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" Text="登录后自动打开 Buoy" />
                  </StackPanel>
                  <CheckBox x:Name="LaunchAtLoginBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="LaunchAtLoginBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="外观" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" Text="跟随浅色或深色" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="track" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="LightButton" Classes="segment" Content="浅色" Click="ThemeButton_Click" Tag="Light" />
                      <Button x:Name="DarkButton" Classes="segment" Content="深色" Click="ThemeButton_Click" Tag="Dark" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="系统毛玻璃材质" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="窗口背后用 macOS 原生 vibrancy，跟随浅色 / 深色" />
                  </StackPanel>
                  <CheckBox x:Name="VibrancyBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="VibrancyBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="字体" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" Text="主窗口、设置窗口和桌面卡片" />
                  </StackPanel>
                  <ComboBox x:Name="FontBox" Grid.Column="1" Width="132" MinHeight="28" HorizontalAlignment="Right"
                            SelectionChanged="FontBox_SelectionChanged">
                    <ComboBoxItem Content="系统默认" Tag="system" />
                    <ComboBoxItem Content="圆体" Tag="rounded" />
                    <ComboBoxItem Content="宋体" Tag="song" />
                    <ComboBoxItem Content="思源宋体" Tag="source-serif" />
                    <ComboBoxItem Content="思源黑体" Tag="source-sans" />
                    <ComboBoxItem Content="楷体" Tag="kai" />
                    <ComboBoxItem Content="等宽" Tag="mono" />
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="FilterPage" IsVisible="False">
            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="模型筛选" />
                <TextBlock x:Name="FilterScopeText" Classes="muted" TextWrapping="Wrap" />
                <Border Classes="rule" />
                <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="FilterModelList" Spacing="0" Margin="0,0,10,0" />
                </ScrollViewer>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="FilterSummaryText" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                    <Button Classes="action" Content="全选" Click="FilterSelectAll_Click" />
                    <Button Classes="action" Content="清空" Click="FilterClear_Click" />
                    <Button Classes="action" Content="刷新" Click="FilterRefresh_Click" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="DataPage" IsVisible="False">
            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section-title" Text="本地数据" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="action" Content="打开目录" Click="OpenFolderButton_Click" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="设置文件" Foreground="{DynamicResource AppMutedBrush}" />
                  <TextBlock x:Name="SettingsSizeText" Grid.Column="1" Foreground="{DynamicResource AppAccentBrush}" />
                </Grid>
                <Border Classes="rule" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="本次刷新耗时" Foreground="{DynamicResource AppMutedBrush}" />
                  <TextBlock x:Name="RefreshDurationText" Grid.Column="1" Foreground="{DynamicResource AppAccentBrush}" Text="尚未刷新" />
                </Grid>
                <Border Classes="rule" />
                <TextBlock x:Name="DataFolderText" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="UpdatePage" IsVisible="False">
            <Border Classes="group" Padding="12,10">
              <StackPanel Spacing="9">
                <TextBlock Classes="section-title" Text="更新" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="自动检查更新" Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="启动后每 24 小时检查一次清单。跨平台安装包还不能自动安装。" />
                  </StackPanel>
                  <CheckBox x:Name="AutoUpdateBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Click="AutoUpdateBox_Click" />
                </Grid>
                <Border Classes="rule" />
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="更新清单地址" />
                  <TextBox x:Name="ManifestBox" Classes="field" MinHeight="30" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Classes="action" Content="保存" Click="SaveUpdateButton_Click" />
                  <Button x:Name="CheckUpdateButton" Classes="action" Content="检查更新" Click="CheckUpdateButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <TextBlock x:Name="StatusText" Grid.Row="2" Classes="muted" Margin="0,6,0,0" MinHeight="16"
                 Text="设置只保存在本机" TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
